# Free LLM — choose "ollama" (free local) or "groq" (free cloud)
LLM_PROVIDER=ollama

# Ollama (free local): install from https://ollama.com → ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq (free cloud): sign up at https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings run locally — no API key needed
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/faiss_index
UPLOAD_DIR=./data/uploads
